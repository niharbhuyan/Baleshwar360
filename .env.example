# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENWEATHERMAP_API_KEY: API key for live location-based OpenWeatherMap weather & severe alerts.
# Configure via the Secrets panel in AI Studio.
OPENWEATHERMAP_API_KEY=YOUR_OPENWEATHERMAP_API_KEY

# MAPS_API_KEY: Optional Google Maps Android API Key.
# Configure via the Secrets panel in AI Studio with package name 'com.niharsales.baleshwar360'
# and SHA-1 certificate fingerprint '3D:C1:86:5F:03:CE:1F:5C:D6:7B:E9:63:29:0B:BD:B2:B7:15:D2:8F'.
# If left as placeholder, the app automatically falls back to google-services.json & keyless OSMDroid maps.
MAPS_API_KEY=YOUR_MAPS_API_KEY

# NEWS_API_KEY: Optional NewsAPI key for Balasore daily news aggregation (auto-injected via AI Studio Secrets into BuildConfig.NEWS_API_KEY; keyless Google News RSS runs automatically if unset).
NEWS_API_KEY=YOUR_NEWS_API_KEY

# Non-secret / backend-only optional overrides (auto-configured automatically; no manual secret needed):
# BALASORE_DB_PATH=backend/data/balasore_realtime.db
# FIREBASE_SERVICE_ACCOUNT_PATH=
