<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/callout_card_container"
        android:layout_width="276dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_osm_callout_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Category Badge, Distance & Close Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_callout_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_osm_callout_pill"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="BEACH"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_callout_distance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="16 km from Balasore"
                android:textColor="#475569"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_callout_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hotspot Title -->
        <TextView
            android:id="@+id/tv_callout_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Chandipur-on-Sea"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Bilingual Secondary Name -->
        <TextView
            android:id="@+id/tv_callout_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ଚାନ୍ଦିପୁର ବେଳାଭୂମି"
            android:textColor="#0369A1"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Short Description from Tourism Database -->
        <TextView
            android:id="@+id/tv_callout_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="World-famous intertidal coast where the sea recedes up to 5 km twice daily."
            android:textColor="#334155"
            android:textSize="11.5sp" />

        <!-- Timings & Entry Fee Metadata -->
        <TextView
            android:id="@+id/tv_callout_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="5:30 AM - 8:30 PM • Free Entry"
            android:textColor="#0F766E"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Interactive Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_callout_details"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_osm_callout_card"
                android:gravity="center"
                android:text="Details"
                android:textColor="#0284C7"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_callout_directions"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_osm_callout_pill"
                android:gravity="center"
                android:text="Directions"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Downward Caret Pointer -->
    <TextView
        android:id="@+id/view_callout_pointer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-5dp"
        android:text="▼"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
